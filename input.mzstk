# This is a sample MZSTK script that calculates factorial of a number

S  # Start of program

# Function to calculate factorial (function number 1)
@1
    # Function takes one argument (n) on stack
    # Store n in variable 'a'
    :1
    
    # Push 1 to stack (initial result)
    1
    
    # While loop to calculate factorial
    {
        # Condition: a > 0
        ;1 0 >
        
        L  # Start of loop statements
            # Multiply result by a
            ;1 *
            
            # Decrement a
            ;1 1 - :1
        X  # End of loop statements
    }
    
    # Result is now on top of stack
$  # End function

# Main program
# Get input from user
^  # Input pushes to stack

!1


V  # Print top of stack

E  # End of program
